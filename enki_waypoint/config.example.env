# Environment variables for enki_waypoint. Leave a line empty to use the default.
# Copy this file somewhere private, fill in what you need, then `set -a; . ./my.env; set +a`.
MALAKOPIA_JOBS_STATE_DIR=
ENKI_ADAPTIVE_STATE_ROOT=
# Standard XDG variable: base folder for the default queue state on Linux (macOS uses Library/Application Support).
XDG_STATE_HOME=
