# Environment variables for write_guards. Every line below may stay empty: an empty value means "unset, use the default".
# Copy this file somewhere private, fill in what you need, then `set -a; . ./my.env; set +a`.

# guarded_write.py: the folder that holds its lock files (created 0700, must be yours). Default: $XDG_STATE_HOME/twu-write-locks
TWU_WRITE_LOCK_DIR=
# Per-user state folder used for the default lock folder. Default: ~/.local/state. Must be an absolute path (a relative one is ignored).
XDG_STATE_HOME=
# TEST HOOKS for write_guard.py (they make every write wait; never set them in normal use):
#   WRITE_GUARD_HOLD_S    seconds to hold the lock before writing
#   WRITE_GUARD_HOLD_FILE hold the lock while this file exists (60 s cap)
WRITE_GUARD_HOLD_S=
WRITE_GUARD_HOLD_FILE=
