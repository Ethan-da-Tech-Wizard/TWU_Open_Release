# Environment variables for net_persistence_guards. Every line is safe to leave empty: an empty value means
# "use the default" (tests cover this). Copy this file somewhere private, fill in what you need, then:
#   set -a; . ./my.env; set +a
# State folder: baselines and receipts go to $TWU_ROOT/data/netguard (default: the folder above scripts/).
TWU_ROOT=
# Folder scanned by persistence_guard instead of your real home (default: your home).
TWU_PERSIST_HOME=
# Opt-in JSON file of exempt startup items, each bound to one path and one content digest (default: none).
TWU_PERSIST_EXEMPT_FILE=
# Opt-in JSON file of exact (proto, port, program) listeners to skip (default: <state>/allow_listen.json, if present).
TWU_NET_ALLOW_LISTEN_FILE=
# sha256 (hex) the listener allow file must have; a different file is rejected and the check reports it (default: no pin).
TWU_NET_ALLOW_LISTEN_SHA256=
# Opt-in JSON file of exact (program, port) outbound pairs to skip (default: <state>/allow_outbound.json, if present).
TWU_NET_ALLOW_OUTBOUND_FILE=
# sha256 (hex) the outbound allow file must have (default: no pin).
TWU_NET_ALLOW_OUTBOUND_SHA256=
