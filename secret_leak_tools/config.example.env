# Environment variables for secret_leak_tools. Every line below may stay empty: an empty value means "unset, use the default".
# Copy this file somewhere private (it can name private paths), fill in what you need, then `set -a; . ./my.env; set +a`.
# Lists (marked "list") are separated by the path separator, ":" on macOS and Linux.

# Where data/netguard/ and data/health/ receipts are written. Default: the folder above scripts/.
TWU_ROOT=
# Per-user state folder for the fingerprint salt (and write_guards' lock folder). Default: ~/.local/state. Must be absolute.
XDG_STATE_HOME=
# Exact salt file. Default: $XDG_STATE_HOME/twu-leakguard/fingerprint_salt (created 0600 on first use).
TWU_FP_SALT_FILE=
# Speed-up cache of secret_scan.py. Default: ~/.cache/twu/secret_scan_cache.json
TWU_SECRET_SCAN_CACHE=
# list: path prefixes (relative to the scanned repo) that secret_scan.py never scans. Default: none.
TWU_SECRET_SCAN_SKIP_PREFIXES=
# Absolute path of git. Default: /usr/bin/git, /opt/homebrew/bin/git or /usr/local/bin/git (never looked up on PATH).
TWU_GIT=
# JSON file {"hosts": [...]} of private host names the git hook must block. Default: private_hosts.json next to the script or in ../data.
TWU_PRIVATE_HOSTS_FILE=
# Older name of the same setting, still read when TWU_PRIVATE_HOSTS_FILE is empty.
TWU_REDACTIONS_FILE=
# Set to exactly 1 for ONE git command to let it through when python3, git or the hook script is missing. Leave empty normally.
LEAKGUARD_ALLOW_MISSING=
# twu_leakwatch.py: folder (relative to the scan root, or absolute) with notes holding your own phone and address. Default: none read.
TWU_LEAKWATCH_PROFILE_DIR=
# twu_leakwatch.py zone lists, each a "list". Defaults: empty, so every file is zone "other" and only secrets are reported.
TWU_LEAKWATCH_PRIVATE_PREFIXES=
TWU_LEAKWATCH_SYNC_PREFIXES=
TWU_LEAKWATCH_OUTBOUND_GLOBS=
TWU_LEAKWATCH_BUSINESS_PREFIXES=
# JSON file with the same four lists as keys (private_prefixes, sync_prefixes, outbound_globs, business_prefixes). Default: data/health/leakwatch_zones.json
TWU_LEAKWATCH_ZONES_FILE=
# list: extra folder names twu_leakwatch.py never enters (built in: .git node_modules __pycache__ .venv).
TWU_LEAKWATCH_SKIP_DIRS=
